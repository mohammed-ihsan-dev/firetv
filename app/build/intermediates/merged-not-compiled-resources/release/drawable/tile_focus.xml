<?xml version="1.0" encoding="utf-8"?>
<!-- Glass overlay drawn on top of every tile: specular sheen on the upper half + hairline / focus border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:type="linear" android:startColor="#47FFFFFF"
                        android:centerColor="#0DFFFFFF" android:endColor="#00FFFFFF" android:centerY="0.45" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.5dp" android:color="#F2FFFFFF" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
            <!-- thin dark inner line: keeps the ring visible on white banners (YouTube, Netflix) -->
            <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#8C0B0C10" />
                    <corners android:radius="9.5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:type="linear" android:startColor="#1FFFFFFF"
                        android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/border_subtle" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
